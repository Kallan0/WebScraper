GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# On Render, set FRONTEND_URL=https://web-scraper-pearl-iota.vercel.app
# Keep the localhost value below for local development.
FRONTEND_URL=http://localhost:5173
MAX_SCRAPED_CHARACTERS=50000
MAX_SUMMARY_CHARACTERS=12000
MAX_RESPONSE_BYTES=10000000

# Identifies this app to websites; use a real app or contact URL.
SCRAPER_USER_AGENT=AIWebScraper/0.1 (https://github.com/Kallan0/WebScraper)
